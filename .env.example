# Existing direct ButterflyGuy settings (placeholders only)
SCHWAB_API_KEY=<schwab-app-key>
SCHWAB_SECRET_KEY=<schwab-app-secret>
SCHWAB_ACCOUNT_ID=<schwab-account-number>
SCHWAB_TOKEN_PATH=tokens.json
DATABASE_PASSWORD=<database-password>

# Compose interpolation value: put this in infra/.env as an absolute directory.
# The Butterfly Guy Compose file refuses to start if it is absent; it is not a token value.
SCHWAB_GATEWAY_TOKEN_DIR=/absolute/path/to/schwab-token-directory

# Client-side market-data gateway selection remains opt-in and staged per paper
# strategy. Keep these Compose interpolation values in infra/.env, not the root
# application .env. Account, order, transaction, reconciliation, and token access
# remain direct regardless of these market-data toggles.
SCHWAB_ACCESS_MODE_XSP=direct
SCHWAB_ACCESS_MODE_SPX=direct
SCHWAB_ACCESS_MODE_NDX=direct
SCHWAB_ACCESS_MODE_REPORT=direct
# Host cron cannot resolve the Docker-only schwab-gateway service alias.
SCHWAB_GATEWAY_REPORT_URL=http://127.0.0.1:8011
SCHWAB_GATEWAY_URL=http://schwab-gateway:8011
SCHWAB_GATEWAY_API_KEY=<scoped-internal-api-key>

# Optional direct-authoritative comparison, also staged independently.
SCHWAB_GATEWAY_SHADOW_READS_XSP=false
SCHWAB_GATEWAY_SHADOW_READS_SPX=false
SCHWAB_GATEWAY_SHADOW_READS_NDX=false
