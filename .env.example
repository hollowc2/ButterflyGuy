# Existing direct ButterflyGuy settings (placeholders only)
SCHWAB_API_KEY=<schwab-app-key>
SCHWAB_SECRET_KEY=<schwab-app-secret>
SCHWAB_ACCOUNT_ID=<schwab-account-number>
SCHWAB_TOKEN_PATH=tokens.json
DATABASE_PASSWORD=<database-password>

# Isolated read-only gateway foundation
SCHWAB_GATEWAY_BIND_HOST=127.0.0.1
SCHWAB_GATEWAY_PORT=8010
SCHWAB_GATEWAY_INTERNAL_KEYS_PATH=/run/secrets/schwab-gateway-keys.json
SCHWAB_GATEWAY_LOG_LEVEL=INFO
SCHWAB_GATEWAY_ORDER_WRITES_ENABLED=false

# Client-side gateway selection remains opt-in; production default is direct.
SCHWAB_ACCESS_MODE=direct
SCHWAB_GATEWAY_URL=http://127.0.0.1:8010
SCHWAB_GATEWAY_API_KEY=<scoped-internal-api-key>
