# Copy to session.env in /opt/butterflyguy-releases/spx-live-<DATE>-<sha7>/ and fill in.
# DATE=YYYY-MM-DD makes every activation abort at its first gate.
DATE=YYYY-MM-DD
# git-archive release snapshot of the reviewed commit (holds infra/ and tools/).
REL=/opt/butterflyguy/.releases/<sha7>-spx-live-XXXXXXXX
# Immutable digest of butterflyguy:release-<sha7>.
CAND=sha256:<digest>
# 1 = Phase 3 paper-mode rehearsal on butterfly_guy_spx_live_rehearsal.
REHEARSAL=0
# Close-out timer time (PT), shown in the activation message. Default 13:45.
CLOSEOUT_PT=13:45
