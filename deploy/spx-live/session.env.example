# Copy to session.env in /opt/butterflyguy-releases/spx-live-<DATE>-<sha7>/ and fill in.
# DATE=YYYY-MM-DD makes every activation abort at its first gate.
DATE=YYYY-MM-DD
# git-archive release snapshot of the reviewed commit (holds infra/ and tools/).
REL=/opt/butterflyguy/.releases/<sha7>-spx-live-XXXXXXXX
# Immutable digest of butterflyguy:release-<sha7>.
CAND=sha256:<digest>
# 1 = Phase 3 paper-mode rehearsal on butterfly_guy_spx_live_rehearsal.
REHEARSAL=0
# 1 = observe only: the real live bot (live DB, Schwab reads) with every entry blocked by
# infra/docker-compose.spx-live-observe.yml. No orders. Refused on a rehearsal.
OBSERVE=0
# Live exit rule. Empty = the default bid ladder (the first concurrent live day). mid_walk =
# the exit-ladder study's R3 pilot, from the second live day on (owner, 2026-11-18). Refused
# on a rehearsal.
EXIT_PRICING=
# Close-out timer time (PT), shown in the activation message. Default 13:45.
CLOSEOUT_PT=13:45

# Optional health.sh readiness warning. Same /ready reason must persist across two
# consecutive health runs in the same container run. Lifecycle reasons are ignored.
CHECK_READY=0
