# Daily report card — 21:30 UTC weekdays (1:30 PM PST / 2:30 PM PDT, 30 min after the 4:00 PM ET close in winter).
# Vixie cron ignores CRON_TZ in user crontabs; use UTC slot.
# Install:
#   crontab -l 2>/dev/null | grep -v send_daily_report_card | cat - infra/cron/daily_report_card.cron | crontab -
# cron_guard posts a Discord alert (DISCORD_WEBHOOK_URL) if the job exits non-zero.
30 21 * * 1-5 cd /opt/butterflyguy && /opt/butterflyguy/.venv/bin/python tools/cron_guard.py --job daily_report_card -- /opt/butterflyguy/.venv/bin/python tools/send_daily_report_card.py >> /opt/butterflyguy/daily_report_card.log 2>&1
