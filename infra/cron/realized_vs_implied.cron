# SPX realized-vs-implied weekly post — Monday 15:30 UTC (11:30 ET EDT / 10:30 ET EST).
# Friday's official close reaches daily_bars when the next session's collector runs.
# Template assumes the cron daemon schedules in UTC. Verify its timezone first.
# Install through the host's normal reviewed crontab workflow; retain unrelated jobs.
# cron_guard posts a Discord alert (DISCORD_WEBHOOK_URL) if the job exits non-zero.
30 15 * * 1 cd /opt/butterflyguy && /opt/butterflyguy/.venv/bin/python tools/cron_guard.py --job realized_vs_implied -- /opt/butterflyguy/.venv/bin/python tools/send_realized_vs_implied.py >> /opt/butterflyguy/realized_vs_implied.log 2>&1
