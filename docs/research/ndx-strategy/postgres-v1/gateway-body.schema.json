      },
      "required": [
        "symbol",
        "option_type",
        "expiration",
        "strike",
        "bid",
        "ask",
        "mark",
        "stale"
      ],
      "title": "OptionContractV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "option_chain": {
      "$ref": "#/$defs/OptionChainV1"
    }
  },
  "required": [
    "option_chain"
  ],
  "title": "OptionChainResponseV1",
  "type": "object"
}
