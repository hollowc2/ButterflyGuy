{
  "$defs": {
    "OptionChainV1": {
      "additionalProperties": false,
      "description": "A complete normalized chain for one symbol and one expiration.\n\nThe response is hard-bounded at ``MAX_OPTION_CHAIN_CONTRACTS_V1``. The gateway\nrefuses an oversized upstream payload instead of silently truncating contracts,\nbecause a partial strike set is unsafe for strategy selection and position marks.",
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "expiration": {
          "format": "date",
          "title": "Expiration",
          "type": "string"
        },
        "underlying_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underlying Price"
        },
        "call_contract_count": {
          "title": "Call Contract Count",
          "type": "integer"
        },
        "put_contract_count": {
          "title": "Put Contract Count",
          "type": "integer"
        },
        "strike_count": {
          "title": "Strike Count",
          "type": "integer"
        },
        "contracts": {
          "items": {
            "$ref": "#/$defs/OptionContractV1"
          },
          "title": "Contracts",
          "type": "array"
        },
        "event_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Timestamp"
        },
        "gateway_received_at": {
          "format": "date-time",
          "title": "Gateway Received At",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Seconds"
        },
        "data_quality_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Data Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "expiration",
        "call_contract_count",
        "put_contract_count",
        "strike_count",
        "contracts",
        "gateway_received_at",
        "source",
        "stale"
      ],
      "title": "OptionChainV1",
      "type": "object"
    },
    "OptionContractV1": {
      "additionalProperties": false,
