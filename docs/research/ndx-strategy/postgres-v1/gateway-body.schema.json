        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Seconds"
        },
        "data_quality_flags": {
          "default": [],
          "items": {
