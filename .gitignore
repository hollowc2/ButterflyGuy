# Local research output (intentionally untracked)
/reports/

# Credential-proof and runtime-baseline evidence (mode 0600, retained on the host).
# These are deliberately kept on Helios and must never be committed; a stray `git add -A`
# there would otherwise capture them along with the token advisory lock.
.credential-proof-state-*.json
.credential-proof-evidence-*.json
.baseline-candidate-evidence-*.json
.runtime-baseline-evidence-*.json
*.json.lock
.tokens.json.lock
/evidence/
